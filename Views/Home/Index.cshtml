@{ ViewData["Title"] = "Inicio"; }

<header class="hero text-center text-white">
    <div class="container py-5">
        <h1 class="display-4">Donde Darío</h1>
        <p class="lead mb-0">Sabores auténticos de la gastronomía colombiana.</p>
        <a class="btn btn-reserva btn-lg mt-4" asp-controller="Reservas" asp-action="Crear">Reserva tu mesa</a>
    </div>
</header>

<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-7">
                <h2>Sobre nosotros</h2>
                <p>En Donde Darío compartimos los sabores auténticos de la gastronomía colombiana, preparados al momento y con recetas de siempre.</p>
                <div class="row">
                    <div class="col-6">
                        <h3 class="h6 text-uppercase text-muted">Nuestras estrellas</h3>
                        <ul><li>Bandeja paisa</li><li>Cazuela típica</li></ul>
                    </div>
                    <div class="col-6">
                        <h3 class="h6 text-uppercase text-muted">Cómo servimos</h3>
                        <ol><li>Entradas</li><li>Platos fuertes</li></ol>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <aside class="alert alert-success mb-0">Comida preparada al momento, con ingredientes frescos del día.</aside>
            </div>
        </div>
    </div>
</section>